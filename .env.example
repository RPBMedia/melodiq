# --- Database ---
# SQLite (default, zero-config for local dev):
DATABASE_URL="file:./dev.db"
# For production swap to Postgres and change provider in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/melodiq?schema=public"

# --- Auth.js / NextAuth ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Google OAuth credentials (see README -> "Setting up Google login")
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Base URL of the app (used by Auth.js for callbacks)
# Dev:
NEXTAUTH_URL="http://localhost:3000"
