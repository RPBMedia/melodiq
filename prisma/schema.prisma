// MelodIQ database schema
// Postgres in every environment (serverless-friendly for Vercel). Point
// DATABASE_URL at your Postgres instance (Neon / Vercel Postgres / Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Auth.js (NextAuth) models -----

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set only for email/password accounts; null for OAuth
  createdAt     DateTime      @default(now())

  // Progression (M3). XP is the source of truth; level/rank are derived in
  // src/lib/progression.ts. Daily streak is stamped on the day's daily finish.
  xp            Int           @default(0)
  dailyStreak   Int           @default(0)
  lastDailyDate String? // "YYYY-MM-DD" (UTC) of the last completed Daily Challenge

  accounts      Account[]
  sessions      Session[]
  games         GameSession[]
  achievements  UserAchievement[]
  stageProgress UserStageProgress[]
  matchesMade   Match[]             @relation("MatchCreator")
  matchPlays    MatchPlayer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ----- App domain models -----

// A track in the guessing pool. previewUrl should point to a LEGAL 30s preview
// (e.g. the iTunes Search API previewUrl) or be null to fall back to a silent
// timed round. We never store or ship full copyrighted audio.
model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String
  genre      String
  year       Int?
  difficulty Int      @default(2) // PRD M2 tiers: 1 easy · 2 medium · 3 hard
  provider   String? // preview source: "itunes" | "deezer" | null
  coverColor String   @default("#8B5CF6") // seeds the gradient placeholder art
  previewUrl String? // legal 30s preview; null => silent timed round
  createdAt  DateTime @default(now())

  rounds Round[]

  @@index([genre])
  @@index([difficulty])
}

// One completed 10-song game. The public leaderboard is a ranked read over
// these rows (top scores joined to their user), so "leaderboard scores" live
// here rather than in a duplicated table.
model GameSession {
  id           String    @id @default(cuid())
  userId       String
  score        Int       @default(0)
  correctCount Int       @default(0)
  totalRounds  Int       @default(10)
  mode         String    @default("multiple") // "multiple" | "typing" | "survival" | "speed"
  genre        String? // null => all genres
  dailyDate    String? // "YYYY-MM-DD" (UTC) if this game is that day's Daily Challenge; else null
  stageId      String? // a Genre Journey stage id (src/lib/journeys.ts) if this game is a journey stage; else null
  matchId      String? // set when this game is a player's turn in an async Head-to-Head match; disables hints
  createdAt    DateTime  @default(now())
  finishedAt   DateTime? // set when the game is completed; only finished games count

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds      Round[]
  matchPlayer MatchPlayer?

  // One Daily Challenge per user per day. Normal games (dailyDate = null) are
  // unaffected — Postgres treats NULLs as distinct, so they never collide.
  @@unique([userId, dailyDate])
  @@index([userId])
  @@index([score])
  @@index([finishedAt])
  @@index([dailyDate])
}

// Per-song detail within a game. Rows are pre-created at game start (songId +
// order). `startedAt` is stamped server-side when the clip begins and
// `answeredAt` when the guess arrives, so elapsed time — and therefore the
// score — is computed entirely from server clocks, never trusted from the client.
model Round {
  id            String    @id @default(cuid())
  gameSessionId String
  songId        String
  guessedTitle  String?
  correct       Boolean   @default(false)
  timeMs        Int       @default(0)
  points        Int       @default(0)
  hintsUsed     Int       @default(0) // Genre-Journey/Classic hints spent this round; deducts from score
  order         Int       @default(0)
  startedAt     DateTime?
  answeredAt    DateTime?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  song        Song        @relation(fields: [songId], references: [id])

  @@unique([gameSessionId, order])
  @@index([gameSessionId])
}

// An achievement a user has unlocked. The catalog itself is code-defined in
// src/lib/achievements.ts; only the unlock is persisted, keyed by that id.
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String // matches an id in src/lib/achievements.ts
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// Best result a user has earned on a Genre Journey stage. The journey/stage
// catalog is code-defined in src/lib/journeys.ts; only the best star count is
// persisted, keyed by that stage id. Stars: 0–3.
model UserStageProgress {
  id        String   @id @default(cuid())
  userId    String
  stageId   String // matches a stage id in src/lib/journeys.ts
  stars     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
  @@index([userId])
}

// An async Head-to-Head match: everyone plays the SAME seeded clip set and scores
// are compared. `players` is a collection (not player1/player2 columns) so the
// same model supports 2 today and up to MATCH_MAX_PLAYERS later with no migration.
model Match {
  id          String   @id @default(cuid())
  creatorId   String
  seed        String // deterministic clip set (shared by every player), like the Daily
  genre       String? // null => all genres
  mode        String   @default("multiple") // always multiple-choice; hints are disabled for matches
  totalRounds Int      @default(10)
  maxPlayers  Int      @default(2) // 2 (1v1) up to MATCH_MAX_PLAYERS; chosen by the host
  createdAt   DateTime @default(now())

  creator User          @relation("MatchCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  players MatchPlayer[]

  @@index([creatorId])
}

// One player's participation in a match. Their turn is a normal seeded
// GameSession; the score is copied here on finish for a cheap comparison read.
model MatchPlayer {
  id            String    @id @default(cuid())
  matchId       String
  userId        String
  gameSessionId String?   @unique
  score         Int       @default(0)
  correctCount  Int       @default(0)
  finishedAt    DateTime?
  joinedAt      DateTime  @default(now())

  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSession GameSession? @relation(fields: [gameSessionId], references: [id])

  @@unique([matchId, userId]) // one entry per player per match
  @@index([matchId])
  @@index([userId])
}
