// MelodIQ database schema
// Dev uses SQLite for zero-config setup. For production, change provider to
// "postgresql" and point DATABASE_URL at your Postgres instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----- Auth.js (NextAuth) models -----

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())

  accounts Account[]
  sessions Session[]
  games    GameSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ----- App domain models -----

// A track in the guessing pool. previewUrl should point to a LEGAL 30s preview
// (e.g. the iTunes Search API previewUrl) or be null to fall back to a silent
// timed round. We never store or ship full copyrighted audio.
model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String
  genre      String
  year       Int?
  coverColor String   @default("#8B5CF6") // seeds the gradient placeholder art
  previewUrl String? // legal 30s preview; null => silent timed round
  createdAt  DateTime @default(now())

  rounds Round[]

  @@index([genre])
}

// One completed 10-song game. The public leaderboard is a ranked read over
// these rows (top scores joined to their user), so "leaderboard scores" live
// here rather than in a duplicated table.
model GameSession {
  id           String    @id @default(cuid())
  userId       String
  score        Int       @default(0)
  correctCount Int       @default(0)
  totalRounds  Int       @default(10)
  mode         String    @default("multiple") // "multiple" | "typing"
  genre        String? // null => all genres
  createdAt    DateTime  @default(now())
  finishedAt   DateTime? // set when the game is completed; only finished games count

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds Round[]

  @@index([userId])
  @@index([score])
  @@index([finishedAt])
}

// Per-song detail within a game. Rows are pre-created at game start (songId +
// order). `startedAt` is stamped server-side when the clip begins and
// `answeredAt` when the guess arrives, so elapsed time — and therefore the
// score — is computed entirely from server clocks, never trusted from the client.
model Round {
  id            String    @id @default(cuid())
  gameSessionId String
  songId        String
  guessedTitle  String?
  correct       Boolean   @default(false)
  timeMs        Int       @default(0)
  points        Int       @default(0)
  order         Int       @default(0)
  startedAt     DateTime?
  answeredAt    DateTime?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  song        Song        @relation(fields: [songId], references: [id])

  @@unique([gameSessionId, order])
  @@index([gameSessionId])
}
